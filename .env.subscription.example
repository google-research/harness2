# Native CLI subscription authentication. No API keys or proxy are needed.
HARNESS2_TRANSPORT=subscription
HARNESS2_IMPROVER_CHANNEL=claude_cli
HARNESS2_IMPROVER_MODEL=sonnet
# Required: a model available to your installed Codex CLI and ChatGPT account.
HARNESS2_CODEX_MODEL=
HARNESS2_JUDGE_CHANNEL=claude_cli
HARNESS2_JUDGE_MODEL=sonnet
HARNESS2_RUNS_DIR=runs/subscription
