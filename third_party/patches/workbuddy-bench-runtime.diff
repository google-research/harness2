+# ── Dynamic (short-lived) backend keys ───────────────────────────────────────
+# Some backends authenticate with an OAuth access token rather than a static API
+# key — Vertex AI is the motivating case: `gcloud auth print-access-token` mints a
+# token that expires in ~60 min, while a bench run lasts hours (80 tasks x 3
+# attempts). A key resolved once at proxy startup therefore dies mid-run, and 401
+# is not a transport error the sender can retry its way out of.
+#
+# A route may instead declare ``backend.key_command``: a shell command whose
+# stdout is the current key. The proxy caches its output for ``key_ttl`` seconds
+# (default 30 min, half a Vertex token's life) and re-runs it on expiry or when
+# the sender reports a 401. Same shape as the validated pattern in
+# job-bench-eval's eval/tts/judge_opus.py::token().
+DEFAULT_KEY_TTL = 1800.0
+
+# command -> (key, minted_at). Guarded by _KEY_LOCK: concurrent first requests
+# must not each shell out (double-checked inside the lock), and the token must be
+# swapped atomically for in-flight readers.
+_KEY_CACHE: dict[str, tuple[str, float]] = {}
+_KEY_LOCK = threading.Lock()
+
+
+def resolve_key_command(command: str, ttl: float = DEFAULT_KEY_TTL) -> str:
+    """Return the cached output of ``command``, re-running it when stale.
+
+    Blocking on purpose: it runs at most once per ``ttl`` per command (plus once
+    per 401), so the sub-second event-loop stall is far cheaper than threading an
+    async credential provider through the sender. A failing command logs and
+    returns "" — the request then goes out unauthenticated and the backend's own
+    401/403 surfaces the misconfiguration, rather than the proxy dying at an
+    arbitrary point mid-run.
+    """
+    if not command:
+        return ""
+    now = time.time()
+    cached = _KEY_CACHE.get(command)
+    if cached and now - cached[1] <= ttl:
+        return cached[0]
+    with _KEY_LOCK:
+        # Re-check: another thread may have refreshed while we waited.
+        cached = _KEY_CACHE.get(command)
+        if cached and time.time() - cached[1] <= ttl:
+            return cached[0]
+        try:
+            proc = subprocess.run(
+                shlex.split(command), capture_output=True, text=True, timeout=60,
+            )
+        except (OSError, ValueError, subprocess.SubprocessError) as exc:
+            log.error("backend key_command failed to execute (%s): %s", command, exc)
+            return cached[0] if cached else ""
+        key = proc.stdout.strip()
+        if not key:
+            log.error(
+                "backend key_command produced no key (%s): rc=%d stderr=%s",
+                command, proc.returncode, proc.stderr.strip()[:200],
+            )
+            return cached[0] if cached else ""
+        _KEY_CACHE[command] = (key, time.time())
+        log.info("backend key refreshed via key_command (ttl=%.0fs)", ttl)
+        return key
+
+
+def invalidate_key_command(command: str) -> None:
+    """Drop ``command``'s cached key so the next resolve re-runs it (401 recovery)."""
+    if not command:
+        return
+    with _KEY_LOCK:
+        _KEY_CACHE.pop(command, None)
+
