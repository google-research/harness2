+def _capture_thought_signatures(payload: Any, store: "OrderedDict[str, str]") -> None:
+    """Record ``tool_call.id -> thought_signature`` from an OpenAI response payload.
+
+    Handles both shapes: non-streaming (``choices[].message.tool_calls``) and
+    streaming (``choices[].delta.tool_calls``). Best-effort and total: anything
+    unexpected is skipped rather than raised, since this runs on the response hot
+    path and must never break a working stream.
+    """
+    if not isinstance(payload, dict):
+        return
+    for choice in payload.get("choices") or []:
+        if not isinstance(choice, dict):
+            continue
+        target = choice.get("delta")
+        if not isinstance(target, dict):
+            target = choice.get("message")
+        if not isinstance(target, dict):
