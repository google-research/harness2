+    def _evaluate_anthropic_vertex(self, prompt: str, _retries: int) -> dict:
+        """Claude on Vertex AI (ADC auth), e.g. --judge-model vertex/claude-opus-4-8.
+
+        Differs from the direct-Anthropic path in two ways:
+          * No output_config.format — a Vertex organisation policy may deny
+            `structured_outputs` for partner models, which 400s a schema'd
+            request. JSON comes from the prompt and _parse_json instead.
+          * Extended thinking is on (adaptive) with effort from
+            JUDGE_EFFORT (default 'high'), so content[0] can be a thinking
+            block; take the first *text* block rather than content[0].
+        """
+        effort = os.environ.get("JUDGE_EFFORT", "high")
+        last_err: Exception | None = None
+        for attempt in range(_retries):
+            # No output_config.format here, unlike the anthropic/google/openai
+            # paths. Claude on Vertex is a *partner* model, and a Vertex
+            # organisation policy may deny structured_outputs for partner models:
+            #   constraints/vertexai.allowedPartnerModelFeatures -> 400
+            # Sending a schema therefore burns the attempt on a 400 that the
+            # `except Exception: continue` below swallows, leaving only the
+            # schema-free attempts real. Every attempt here is unstructured and
+            # so genuinely retries; _parse_json repairs the malformed JSON the
+            # judge sometimes emits (unescaped quotes when citing source text).
+            output_config: dict = {"effort": effort}
+            try:
+                response = self.client.messages.create(
+                    model=self.model,
+                    max_tokens=32000,
+                    system=self._VERTEX_SYSTEM,
+                    thinking={"type": "adaptive"},
+                    output_config=output_config,
+                    messages=[{"role": "user", "content": prompt}],
+                )
+            except Exception as e:
+                last_err = e
+                continue
+
+            if response.stop_reason == "max_tokens":
+                input_tokens = response.usage.input_tokens if response.usage else "unknown"
+                raise ValueError(
+                    f"Judge response truncated (stop_reason=max_tokens, "
+                    f"input_tokens={input_tokens}, max_tokens=32000). "
+                    f"The agent output is likely too large for the judge context window. "
+                    f"Ensure criteria have deliverables lists to scope output."
+                )
+
+            text = next((b.text for b in response.content if b.type == "text"), "")
+            try:
+                return self._parse_json(text)
+            except (ValueError, json.JSONDecodeError) as e:
+                last_err = e
+        raise ValueError(
+            f"Judge returned unparseable response after {_retries} attempts: {last_err}"
+        )
 
