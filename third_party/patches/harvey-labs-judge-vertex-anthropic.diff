+    # System steer replaces the structured-output constraint we can't use on
+    # Vertex (see _evaluate_anthropic_vertex). The rubric prompt already asks
+    # for a fenced JSON object, and _parse_json strips the fences.
+    _VERTEX_SYSTEM = (
+        "You are an evaluation judge. You must return valid JSON only, "
+        "with no markdown formatting or extra text."
+    )
